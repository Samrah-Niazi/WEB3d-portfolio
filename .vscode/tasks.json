{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend (site)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "portfolio"
      }
    },
    {
      "label": "Backend (API)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "portfolio"
      }
    },
    {
      "label": "Start portfolio (site + API)",
      "dependsOn": [
        "Frontend (site)",
        "Backend (API)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Install dependencies (first time)",
      "type": "shell",
      "command": "npm install --prefix frontend; npm install --prefix backend",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build for Go Live",
      "type": "shell",
      "command": "npm run build:live",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    }
  ]
}
