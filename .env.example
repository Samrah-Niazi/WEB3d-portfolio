# Copy to backend/.env and fill in. Never commit the real file.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Module 4: chatbot
ANTHROPIC_API_KEY=
# Optional overrides
# CHAT_MODEL=claude-haiku-5-5
# MIN_SCORE=0.22
# EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# Module 5: contact form
# Gmail: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it (no spaces) as SMTP_PASS.
SMTP_USER=
SMTP_PASS=
# Where messages are delivered (defaults to SMTP_USER)
CONTACT_TO=
# Optional: another SMTP provider (defaults: smtp.gmail.com, 465)
# SMTP_HOST=
# SMTP_PORT=
